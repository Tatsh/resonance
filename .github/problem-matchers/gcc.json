{
  "problemMatcher": [
    {
      "owner": "gcc",
      "pattern": [
        {
          "column": 3,
          "file": 1,
          "line": 2,
          "message": 5,
          "regexp": "^(.*?):(\\d+):(\\d+):\\s+(?:fatal\\s+)?(warning|error):\\s+(.*)$",
          "severity": 4
        }
      ]
    }
  ]
}
