; GfxDevice::Init() sends the VU1 microprogram, from the .vutext section at 0x00664ab0, through
; VIF1 with the DMA chain below. Each MPG block loads at the VU address it specifies. The entry
; points are Vu1Init (MSCAL from GfxDevice::Init()), Vu1DrawTexturedFaces and
; Vu1DrawUntexturedFaces (Rnd::PsMesh faces), Vu1DrawEdges (Rnd::PsMesh edges), Vu1DrawSprites
; (Rnd::PsParticleSys), and Vu1DrawInstances (Rnd::PsMultiMesh). The face and instance paths
; call a lighting routine through the address in the batch header (Vu1LightUnlit,
; Vu1LightDirectional, Vu1LightPoint, or Vu1LightNone). The clipper selects a plane by jumping
; into the table of four-instruction stubs at Vu1TexturedClipMinusZ or Vu1UntexturedClipMinusZ.
; The chain ends by resetting the double-buffer base, offset, and cycle.

	.data
	.align 4
	.global g_vu1MicrocodeChain
g_vu1MicrocodeChain:
	dmacnt *

	mpg 0x0, *
Vu1DrawTexturedFaces:
	nop                             loi 255.0
	addi.x VF13, VF00, I            xtop VI02
	nop                             lqi VF03, (VI02++)
	nop                             lqi VF04, (VI02++)
	nop                             lqi VF05, (VI02++)
	nop                             lqi VF06, (VI02++)
	nop                             lqi VF07, (VI02++)
	nop                             lqi VF10, (VI02++)
	nop                             lqi VF11, (VI02++)
	nop                             lqi VF12, (VI02++)
	nop                             lqi VF16, (VI02++)
	nop                             lqi VF17, (VI02++)
	nop                             lqi VF18, (VI02++)
	nop                             mtir VI05, VF02x
	nop                             lqi VF01, (VI02++)
	nop                             lqi VF27, (VI02++)
	nop                             lqi VF26, (VI02++)
	nop                             lqi VF19, (VI02++)
	nop                             lqi VF20, (VI02++)
	nop                             lqi VF21, (VI02++)
	nop                             ilw.x VI10, 0(VI02)
	nop                             ilw.y VI11, 0(VI02)
	nop                             ilw.z VI12, 0(VI02)
	nop                             ilw.w VI13, 0(VI02)
	nop                             sqi VF01, (VI05++)
	nop                             sq VF27, 995(VI00)
Vu1TexturedNextBatch:
	nop                             xtop VI02
	nop                             ilw.z VI09, 18(VI02)
	nop                             ilw.x VI03, 18(VI02)
	nop                             iaddiu VI02, VI02, 0x13
	nop                             lq VF23, 0(VI02)
	nop                             jalr VI15, VI09
	nop                             iaddiu VI14, VI00, 0xfff
	mulaw ACC, VF07, VF00w          lq VF15, 3(VI02)
	maddax ACC, VF04, VF23x         lq VF09, 2(VI02)
	madday ACC, VF05, VF23y         b Vu1TexturedTransformFirst
	maddz VF23, VF06, VF23z         iaddiu VI01, VI00, 0xfff
Vu1TexturedTransformLoop:
	mulaw ACC, VF07, VF00w          lq VF15, 3(VI02)
	maddax ACC, VF04, VF23x         sq VF27, -1(VI02)
	madday ACC, VF05, VF23y         lq VF09, 2(VI02)
	maddz VF23, VF06, VF23z         sq VF08, -3(VI02)
Vu1TexturedTransformFirst:
	adda.xy ACC, VF18, VF00         isubiu VI03, VI03, 1
	maddax.xy ACC, VF16, VF15x      mr32.z VF15, VF00
	maddy.xy VF15, VF17, VF15y      iand VI14, VI14, VI01
	mulaw.xyz ACC, VF12, VF23w      div Q, VF00w, VF23w
	mulaw.w ACC, VF12, VF00         sq VF23, 0(VI02)
	madd VF08, VF11, VF23           fcset 0
	mul VF01, VF23, VF03            nop
	clipw.xyz VF23, VF23w           nop
	mul VF09, VF10, VF09            nop
	minix.w VF08, VF08, VF13x       nop
	clipw.xyz VF01, VF01w           nop
	mulq.xyz VF08, VF08, Q          iaddiu VI02, VI02, 4
	ftoi0 VF09, VF09                lq VF23, 0(VI02)
	maxx.w VF08, VF08, VF00x        nop
	mulq.xyz VF27, VF15, Q          fcget VI01
	nop                             mfir.w VF27, VI01
	nop                             ibne VI03, VI00, Vu1TexturedTransformLoop
	ftoi4 VF08, VF08                sq VF09, -2(VI02)
	nop                             iand VI14, VI14, VI01
	nop                             ilw.x VI07, 0(VI02)
	nop                             ibne VI14, VI00, Vu1TexturedBatchEnd
	nop                             xtop VI09
	nop                             ilw.y VI03, 18(VI09)
	nop                             ilw.w VI08, 18(VI09)
	nop                             iaddiu VI09, VI09, 0x13
	nop                             iaddiu VI04, VI00, 0x12
	nop                             sq VF27, -1(VI02)
	nop                             sq VF08, -3(VI02)
	nop                             ibeq VI08, VI00, Vu1TexturedUnclippedLoop
	nop                             iadd VI07, VI07, VI09
Vu1TexturedTriangleLoop:
	nop                             lq VF15, 3(VI07)
	nop                             lq VF09, 2(VI07)
	nop                             lq VF08, 1(VI07)
	nop                             ilw.y VI07, 0(VI02)
	nop                             mtir VI08, VF15w
	nop                             sq VF15, 0(VI05)
	nop                             sq VF09, 1(VI05)
	nop                             sq VF08, 2(VI05)
	nop                             isubiu VI03, VI03, 1
	nop                             iadd VI07, VI07, VI09
	nop                             lq VF15, 3(VI07)
	nop                             lq VF09, 2(VI07)
	nop                             lq VF08, 1(VI07)
	nop                             ilw.z VI07, 0(VI02)
	nop                             mtir VI01, VF15w
	nop                             sq VF15, 3(VI05)
	nop                             sq VF09, 4(VI05)
	nop                             sq VF08, 5(VI05)
	nop                             iand VI14, VI08, VI01
	nop                             ior VI08, VI08, VI01
	nop                             iadd VI07, VI07, VI09
	nop                             lq VF15, 3(VI07)
	nop                             lq VF09, 2(VI07)
	nop                             lq VF08, 1(VI07)
	nop                             ilw.x VI07, 1(VI02)
	nop                             mtir VI01, VF15w
	nop                             sq VF15, 6(VI05)
	nop                             sq VF09, 7(VI05)
	nop                             sq VF08, 8(VI05)
	nop                             iand VI14, VI14, VI01
	nop                             ior VI08, VI08, VI01
	nop                             ibne VI14, VI00, Vu1TexturedNextTriangle
	nop                             iaddiu VI02, VI02, 1
	nop                             iaddiu VI01, VI00, 0x3f
	nop                             iand VI01, VI08, VI01
	nop                             nop
	nop                             ibne VI01, VI00, Vu1TexturedClipTriangle
	nop                             iaddiu VI01, VI00, 0x10
	nop                             isubiu VI04, VI04, 1
	nop                             iaddiu VI05, VI05, 9
	nop                             ibne VI04, VI00, Vu1TexturedNextTriangle
	nop                             nop
	nop                             b Vu1TexturedKick
	nop                             iaddiu VI15, VI00, Vu1TexturedNextTriangle
Vu1TexturedClipTriangle:
	nop                             iand VI01, VI08, VI01
	nop                             isw.y VI03, 1023(VI00)
	nop                             ibne VI01, VI00, Vu1TexturedNextTriangle
	nop                             isw.x VI07, 1023(VI00)
	nop                             isw.z VI05, 1023(VI00)
	nop                             isw.w VI02, 1023(VI00)
	nop                             iaddiu VI03, VI00, 0x4000
	nop                             iaddiu VI03, VI03, 0x4000
	nop                             isw.x VI03, 995(VI00)
	nop                             ilw.x VI07, -1(VI02)
	nop                             iaddiu VI01, VI00, 0x3e3
	nop                             nop
	nop                             xgkick VI01
	nop                             iadd VI07, VI07, VI09
	nop                             lq VF15, 3(VI07)
	nop                             lq VF08, 0(VI07)
	nop                             ilw.z VI07, -1(VI02)
	nop                             nop
	mulw.xyz VF15, VF15, VF08w      nop
	nop                             sq VF08, 998(VI00)
	nop                             iadd VI07, VI07, VI09
	nop                             sq VF08, 1007(VI00)
	nop                             sq VF15, 996(VI00)
	nop                             sq VF15, 1005(VI00)
	nop                             lq VF15, 3(VI07)
	nop                             lq VF09, 2(VI07)
	nop                             lq VF08, 0(VI07)
	nop                             ilw.y VI07, -1(VI02)
	mulw.xyz VF15, VF15, VF08w      nop
	itof0 VF09, VF09                nop
	nop                             sq VF08, 1004(VI00)
	nop                             iadd VI07, VI07, VI09
	nop                             sq VF15, 1002(VI00)
	nop                             sq VF09, 1003(VI00)
	nop                             lq VF15, 3(VI07)
	nop                             sq VF09, 997(VI00)
	nop                             lq VF08, 0(VI07)
	nop                             iaddiu VI03, VI00, 3
	mulw.xyz VF15, VF15, VF08w      iaddiu VI06, VI00, Vu1TexturedClipMinusZ
	nop                             iaddiu VI14, VI00, 0x20
	nop                             sq VF08, 1001(VI00)
	nop                             iaddiu VI02, VI00, 0x3e4
	nop                             sq VF15, 999(VI00)
	nop                             sq VF09, 1000(VI00)
	nop                             sq VF09, 1006(VI00)
Vu1TexturedClipPlaneLoop:
	nop                             iand VI01, VI08, VI14
	nop                             iaddiu VI15, VI00, 0
	nop                             ibeq VI01, VI00, Vu1TexturedClipNextPlane
	nop                             iaddiu VI05, VI00, 0x3e4
	nop                             iaddiu VI08, VI00, 0
Vu1TexturedClipEdgeLoop:
	nop                             ilw.w VI01, 0(VI02)
	nop                             ilw.w VI07, 3(VI02)
	nop                             lq VF08, 2(VI02)
	nop                             lq VF25, 5(VI02)
	nop                             iand VI01, VI01, VI14
	nop                             iand VI07, VI07, VI14
	nop                             lq VF15, 0(VI02)
	nop                             ibeq VI01, VI07, Vu1TexturedClipEdgeEnd
	nop                             lq VF23, 3(VI02)
	nop                             jr VI06
	nop                             lq VF09, 1(VI02)
Vu1TexturedClipIntersect:
	nop                             div Q, VF01w, VF27w
	sub VF25, VF25, VF08            nop
	sub VF23, VF23, VF15            nop
	sub VF24, VF24, VF09            fcset 0
	nop                             nop
	nop                             nop
	nop                             nop
	mulq VF25, VF25, Q              nop
	mulq VF23, VF23, Q              nop
	mulq VF24, VF24, Q              nop
	nop                             nop
	add VF08, VF25, VF08            nop
	add VF15, VF23, VF15            nop
	add VF09, VF24, VF09            nop
	nop                             nop
	clipw.xyz VF08, VF08w           sq VF08, 2(VI05)
	clipw.xyz VF08, VF08w           sq VF15, 0(VI05)
	nop                             sq VF09, 1(VI05)
	nop                             iaddiu VI05, VI05, 3
	nop                             iaddiu VI15, VI15, 1
	nop                             fcget VI01
	nop                             isw.w VI01, -3(VI05)
	nop                             ior VI08, VI08, VI01
Vu1TexturedClipEdgeEnd:
	nop                             ibne VI07, VI00, Vu1TexturedClipNextEdge
	nop                             lq VF15, 3(VI02)
	nop                             lq VF09, 4(VI02)
	nop                             lq VF08, 5(VI02)
	nop                             iaddiu VI15, VI15, 1
	nop                             mtir VI01, VF15w
	nop                             sqi VF15, (VI05++)
	nop                             sqi VF09, (VI05++)
	nop                             sqi VF08, (VI05++)
	nop                             ior VI08, VI08, VI01
Vu1TexturedClipNextEdge:
	nop                             isubiu VI03, VI03, 1
	nop                             iaddiu VI02, VI02, 3
	nop                             ibne VI03, VI00, Vu1TexturedClipEdgeLoop
	nop                             nop
	nop                             ibeq VI15, VI00, Vu1TexturedClipRestore
	nop                             iaddiu VI02, VI00, 0x3e4
	nop                             lq VF15, 0(VI02)
	nop                             lq VF09, 1(VI02)
	nop                             lq VF08, 2(VI02)
	nop                             iaddiu VI03, VI15, 0
	nop                             sq VF15, 0(VI05)
	nop                             sq VF09, 1(VI05)
	nop                             sq VF08, 2(VI05)
Vu1TexturedClipNextPlane:
	nop                             iadd VI14, VI14, VI14
	nop                             iaddiu VI01, VI00, 0x400
	nop                             iaddiu VI06, VI06, 4
	nop                             ibne VI14, VI01, Vu1TexturedClipPlaneLoop
	nop                             nop
	nop                             iaddiu VI15, VI03, 0
	nop                             iaddiu VI02, VI00, 0x3e4
Vu1TexturedClipProjectLoop:
	nop                             lq VF08, 2(VI02)
	nop                             lq VF15, 0(VI02)
	nop                             lq VF09, 1(VI02)
	nop                             nop
	mul VF08, VF11, VF08            div Q, VF00w, VF08w
	nop                             nop
	ftoi0 VF09, VF09                nop
	nop                             nop
	add.w VF08, VF12, VF08          nop
	nop                             nop
	nop                             nop
	mulq.xyz VF08, VF08, Q          nop
	minix.w VF08, VF08, VF13x       nop
	mulq.xyz VF15, VF15, Q          nop
	nop                             nop
	add.xyz VF08, VF12, VF08        nop
	maxx.w VF08, VF08, VF00x        nop
	nop                             sqi VF15, (VI02++)
	nop                             sqi VF09, (VI02++)
	nop                             nop
	ftoi4 VF08, VF08                nop
	nop                             isubiu VI15, VI15, 1
	nop                             nop
	nop                             ibne VI15, VI00, Vu1TexturedClipProjectLoop
	nop                             sqi VF08, (VI02++)
	nop                             iaddiu VI03, VI03, 0x4000
	nop                             iaddiu VI03, VI03, 0x4000
	.endmpg

	mpg 0x100, *
	nop                             isw.x VI03, 995(VI00)
	nop                             iaddiu VI01, VI00, 0x3e3
	nop                             nop
	nop                             nop
	nop                             xgkick VI01
Vu1TexturedClipRestore:
	nop                             ilw.x VI07, 1023(VI00)
	nop                             ilw.y VI03, 1023(VI00)
	nop                             ilw.z VI05, 1023(VI00)
	nop                             ilw.w VI02, 1023(VI00)
Vu1TexturedNextTriangle:
	nop                             ibne VI03, VI00, Vu1TexturedTriangleLoop
	nop                             iadd VI07, VI07, VI09
	nop                             bal VI15, Vu1TexturedKick
	nop                             nop
Vu1TexturedBatchEnd:
	nop[e]                          nop
	nop                             nop
	nop                             b Vu1TexturedNextBatch
	nop                             nop
Vu1TexturedClipMinusZ:
	sub.zw VF27, VF08, VF25         lq VF24, 4(VI02)
	addz.w VF01, VF08, VF08z        nop
	nop                             b Vu1TexturedClipIntersect
	addz.w VF27, VF27, VF27z        nop
Vu1TexturedClipPlusX:
	sub.xw VF27, VF08, VF25         lq VF24, 4(VI02)
	subx.w VF01, VF08, VF08x        nop
	nop                             b Vu1TexturedClipIntersect
	subx.w VF27, VF27, VF27x        nop
Vu1TexturedClipMinusX:
	sub.xw VF27, VF08, VF25         lq VF24, 4(VI02)
	addx.w VF01, VF08, VF08x        nop
	nop                             b Vu1TexturedClipIntersect
	addx.w VF27, VF27, VF27x        nop
Vu1TexturedClipPlusY:
	sub.yw VF27, VF08, VF25         lq VF24, 4(VI02)
	suby.w VF01, VF08, VF08y        nop
	nop                             b Vu1TexturedClipIntersect
	suby.w VF27, VF27, VF27y        nop
Vu1TexturedClipMinusY:
	sub.yw VF27, VF08, VF25         lq VF24, 4(VI02)
	addy.w VF01, VF08, VF08y        nop
	nop                             b Vu1TexturedClipIntersect
	addy.w VF27, VF27, VF27y        nop
Vu1TexturedKick:
	nop                             mtir VI01, VF02x
	nop                             iaddiu VI08, VI00, 0x4012
	nop                             isub VI04, VI08, VI04
	nop                             iaddiu VI04, VI04, 0x4000
	nop                             isw.x VI04, 0(VI01)
	nop                             lq VF01, 0(VI01)
	nop                             mtir VI05, VF02y
	nop                             iaddiu VI04, VI00, 0x12
	nop                             xgkick VI01
	nop                             mr32 VF02, VF02
	nop                             jr VI15
	nop                             sqi VF01, (VI05++)
Vu1TexturedUnclippedLoop:
	nop                             lq VF15, 3(VI07)
	nop                             lq VF09, 2(VI07)
	nop                             lq VF08, 1(VI07)
	nop                             ilw.y VI07, 0(VI02)
	nop                             sqi VF15, (VI05++)
	nop                             sqi VF09, (VI05++)
	nop                             sqi VF08, (VI05++)
	nop                             iadd VI07, VI07, VI09
	nop                             lq VF15, 3(VI07)
	nop                             lq VF09, 2(VI07)
	nop                             lq VF08, 1(VI07)
	nop                             ilw.z VI07, 0(VI02)
	nop                             sqi VF15, (VI05++)
	nop                             sqi VF09, (VI05++)
	nop                             sqi VF08, (VI05++)
	nop                             iadd VI07, VI07, VI09
	nop                             lq VF15, 3(VI07)
	nop                             lq VF09, 2(VI07)
	nop                             lq VF08, 1(VI07)
	nop                             ilw.x VI07, 1(VI02)
	nop                             sqi VF15, (VI05++)
	nop                             sqi VF09, (VI05++)
	nop                             sqi VF08, (VI05++)
	nop                             isubiu VI04, VI04, 1
	nop                             isubiu VI03, VI03, 1
	nop                             ibne VI04, VI00, Vu1TexturedUnclippedNext
	nop                             iaddiu VI02, VI02, 1
	nop                             b Vu1TexturedKick
	nop                             iaddiu VI15, VI00, Vu1TexturedUnclippedNext
Vu1TexturedUnclippedNext:
	nop                             ibne VI03, VI00, Vu1TexturedUnclippedLoop
	nop                             iadd VI07, VI07, VI09
	nop                             b Vu1TexturedKick
	nop                             iaddiu VI15, VI00, Vu1TexturedBatchEnd
	.endmpg

	mpg 0x1c2, *
Vu1DrawEdges:
	nop                             loi 255.0
	addi.x VF13, VF00, I            xtop VI02
	nop                             lqi VF04, (VI02++)
	nop                             lqi VF05, (VI02++)
	nop                             lqi VF06, (VI02++)
	nop                             lqi VF07, (VI02++)
	nop                             mtir VI05, VF02x
	nop                             lqi VF01, (VI02++)
	nop                             lqi VF11, (VI02++)
	nop                             lqi VF12, (VI02++)
	nop                             lqi VF19, (VI02++)
	nop                             sqi VF01, (VI05++)
Vu1EdgesNextBatch:
	nop                             xtop VI02
	nop                             lq VF23, 9(VI02)
	nop                             ilw.x VI03, 8(VI02)
	nop                             iaddiu VI02, VI02, 9
	mulaw ACC, VF07, VF00w          nop
	maddax ACC, VF04, VF23x         nop
	madday ACC, VF05, VF23y         nop
	maddz VF23, VF06, VF23z         nop
	ftoi4 VF08, VF08                nop
	nop                             iaddiu VI14, VI00, 0xfff
	mulaw.w ACC, VF12, VF00         fcset 0
	madd.w VF01, VF11, VF23         div Q, VF00w, VF23w
	mulaw.xyz ACC, VF12, VF23w      b Vu1EdgesTransformFirst
	madd.xyz VF08, VF11, VF23       nop
Vu1EdgesTransformLoop:
	maddax ACC, VF04, VF23x         nop
	madday ACC, VF05, VF23y         nop
	maddz VF23, VF06, VF23z         nop
	ftoi4 VF08, VF08                isw.w VI08, -2(VI02)
	nop                             iand VI14, VI14, VI08
	mulaw.w ACC, VF12, VF00         fcset 0
	madd.w VF01, VF11, VF23         div Q, VF00w, VF23w
	mulaw.xyz ACC, VF12, VF23w      sq VF08, -1(VI02)
	madd.xyz VF08, VF11, VF23       nop
Vu1EdgesTransformFirst:
	clipw.xyz VF23, VF23w           iaddiu VI02, VI02, 2
	minix.w VF08, VF01, VF13x       isubiu VI03, VI03, 1
	nop                             lq VF23, 0(VI02)
	mulaw ACC, VF07, VF00w          nop
	mulq.xyz VF08, VF08, Q          ibne VI03, VI00, Vu1EdgesTransformLoop
	maxx.w VF08, VF08, VF00x        fcget VI08
	nop                             ilw.x VI07, 0(VI02)
	nop                             xtop VI09
	ftoi4 VF08, VF08                ilw.y VI03, 8(VI09)
	nop                             iand VI14, VI14, VI08
	nop                             isw.w VI08, -2(VI02)
	nop                             ibne VI14, VI00, Vu1EdgesBatchEnd
	nop                             iaddiu VI09, VI09, 9
	nop                             iaddiu VI04, VI00, 0x36
	nop                             iadd VI07, VI07, VI09
	nop                             sq VF08, -1(VI02)
Vu1EdgesLineLoop:
	nop                             lq VF08, 1(VI07)
	nop                             ilw.w VI08, 0(VI07)
	nop                             ilw.y VI07, 0(VI02)
	nop                             sqi VF19, (VI05++)
	nop                             sqi VF08, (VI05++)
	nop                             isubiu VI03, VI03, 1
	nop                             iadd VI07, VI07, VI09
	nop                             ilw.w VI01, 0(VI07)
	nop                             lq VF08, 1(VI07)
	nop                             iaddiu VI02, VI02, 1
	nop                             ilw.x VI07, 0(VI02)
	nop                             ior VI08, VI08, VI01
	nop                             sqi VF08, (VI05++)
	nop                             ibne VI08, VI00, Vu1EdgesNextLine
	nop                             isubiu VI05, VI05, 3
	nop                             isubiu VI04, VI04, 1
	nop                             iaddiu VI05, VI05, 3
	nop                             ibne VI04, VI00, Vu1EdgesNextLine
Vu1EdgesKick:
	nop                             mtir VI01, VF02x
	nop                             iaddiu VI08, VI00, 0x4036
	nop                             isub VI04, VI08, VI04
	nop                             iaddiu VI04, VI04, 0x4000
	nop                             isw.x VI04, 0(VI01)
	nop                             lq VF01, 0(VI01)
	nop                             mtir VI05, VF02y
	nop                             iaddiu VI04, VI00, 0x36
	nop                             xgkick VI01
	nop                             mr32 VF02, VF02
	nop                             ibeq VI03, VI00, Vu1EdgesBatchEnd
	nop                             sqi VF01, (VI05++)
Vu1EdgesNextLine:
	nop                             ibne VI03, VI00, Vu1EdgesLineLoop
	nop                             iadd VI07, VI07, VI09
	nop                             b Vu1EdgesKick
	nop                             nop
Vu1EdgesBatchEnd:
	nop[e]                          nop
	nop                             nop
	nop                             b Vu1EdgesNextBatch
	nop                             nop
	.endmpg

	mpg 0x258, *
Vu1DrawSprites:
	nop                             xtop VI02
	nop                             lqi VF04, (VI02++)
	nop                             lqi VF05, (VI02++)
	nop                             lqi VF06, (VI02++)
	nop                             lqi VF07, (VI02++)
	nop                             lqi VF10, (VI02++)
