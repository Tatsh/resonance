; GfxDevice::Init() sends the VU0 microprogram, from the .vutext section at 0x00666de0, through
; VIF0 with the DMA chain below. Vu0BlendVectors has no end bit and is not called.

	.data
	.align 4
	.global g_vu0MicrocodeChain
g_vu0MicrocodeChain:
	dmacnt *

	mpg 0x0, *
Vu0BlendVectors:
	nop                             lqi VF03, (VI01++)
	nop                             lqi VF04, (VI02++)
	nop                             nop
	nop                             nop
	mulax.xyz ACC, VF03, VF01x      nop
	maddx.xyz VF05, VF04, VF02x     nop
	nop                             nop
	nop                             nop
	nop                             nop
	nop                             sq VF05, 0(VI03)
	.endmpg
	.enddmadata
	dmaend
